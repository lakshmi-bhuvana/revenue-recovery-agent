<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Revenue Recovery Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        /* =====================================================
           CONVERSATIONAL RECOVERY AI
        ====================================================== */

        .ai-recovery-chat {
            margin: 0 0 24px 0;
            border: 1px solid rgba(99, 102, 241, 0.22);
            border-radius: 16px;

            background:
                linear-gradient(
                    135deg,
                    rgba(99, 102, 241, 0.08),
                    rgba(139, 92, 246, 0.035)
                );

            overflow: hidden;
        }


        /* =====================================================
           AI HEADER
        ====================================================== */

        .ai-chat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 16px;

            padding: 18px 20px;

            border-bottom:
                1px solid rgba(128, 128, 128, 0.15);
        }


        .ai-chat-title {
            display: flex;
            align-items: center;

            gap: 11px;

            min-width: 0;
        }


        .ai-chat-icon {
            width: 36px;
            height: 36px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            background:
                rgba(99, 102, 241, 0.14);

            color: #6366f1;

            font-weight: 700;
        }


        .ai-chat-title strong {
            display: block;

            font-size: 15px;
        }


        .ai-chat-title small {
            display: block;

            margin-top: 3px;

            opacity: 0.62;

            font-size: 11px;
        }


        .ai-chat-header-right {
            display: flex;
            align-items: center;

            gap: 14px;
        }


        .ai-chat-status {
            font-size: 11px;

            white-space: nowrap;

            opacity: 0.7;
        }


        .ai-clear-button {
            border:
                1px solid rgba(128, 128, 128, 0.22);

            background:
                rgba(255,255,255,0.35);

            color: inherit;

            border-radius: 7px;

            padding: 6px 10px;

            cursor: pointer;

            font-size: 11px;
        }


        .ai-clear-button:hover {
            background:
                rgba(99, 102, 241, 0.08);
        }


        /* =====================================================
           CHAT MESSAGE AREA
        ====================================================== */

        .ai-chat-messages {
            height: 300px;

            overflow-y: auto;

            padding: 20px;

            display: flex;
            flex-direction: column;

            gap: 18px;

            scroll-behavior: smooth;
        }


        /* =====================================================
           MESSAGE
        ====================================================== */

        .ai-message {
            display: flex;
            align-items: flex-start;

            gap: 10px;

            max-width: 88%;
        }


        .ai-message-user {
            margin-left: auto;

            flex-direction: row-reverse;
        }


        .ai-avatar {
            width: 30px;
            height: 30px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background:
                rgba(99, 102, 241, 0.14);

            color: #6366f1;

            font-size: 13px;

            font-weight: 700;
        }


        .ai-message-user .ai-avatar {
            background: #6366f1;

            color: white;
        }


        /* =====================================================
           CHAT BUBBLE
        ====================================================== */

        .ai-bubble {
            padding: 11px 14px;

            border-radius: 12px;

            background:
                rgba(255,255,255,0.58);

            border:
                1px solid rgba(128,128,128,0.12);

            line-height: 1.55;

            font-size: 13px;
        }


        .ai-message-user .ai-bubble {
            background: #6366f1;

            color: white;

            border: none;

            border-top-right-radius: 4px;
        }


        .ai-message-assistant .ai-bubble {
            border-top-left-radius: 4px;
        }


        .ai-bubble-name {
            font-size: 10px;

            font-weight: 700;

            margin-bottom: 4px;

            opacity: 0.6;
        }


        .ai-message-user .ai-bubble-name {
            display: none;
        }


        .ai-bubble-text {
            white-space: pre-wrap;
        }


        /* =====================================================
           TYPING
        ====================================================== */

        .ai-typing {
            display: flex;

            align-items: center;

            gap: 4px;

            padding: 4px 2px;
        }


        .ai-typing span {
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: #6366f1;

            animation:
                aiTyping 1.2s infinite ease-in-out;
        }


        .ai-typing span:nth-child(2) {
            animation-delay: 0.15s;
        }


        .ai-typing span:nth-child(3) {
            animation-delay: 0.3s;
        }


        @keyframes aiTyping {

            0%,
            60%,
            100% {
                transform: translateY(0);
                opacity: 0.35;
            }

            30% {
                transform: translateY(-4px);
                opacity: 1;
            }
        }


        /* =====================================================
           SUGGESTIONS
        ====================================================== */

        .ai-chat-suggestions {
            display: flex;

            gap: 7px;

            flex-wrap: wrap;

            padding:
                0 20px 14px 60px;
        }


        .ai-suggestion {
            border:
                1px solid rgba(99, 102, 241, 0.18);

            background:
                rgba(255,255,255,0.35);

            color: inherit;

            border-radius: 20px;

            padding: 7px 11px;

            font-size: 10px;

            cursor: pointer;
        }


        .ai-suggestion:hover {
            background:
                rgba(99, 102, 241, 0.1);

            border-color:
                rgba(99, 102, 241, 0.35);
        }


        /* =====================================================
           INPUT
        ====================================================== */

        .ai-chat-input-area {
            display: flex;

            align-items: flex-end;

            gap: 9px;

            padding: 12px 20px;

            border-top:
                1px solid rgba(128,128,128,0.14);
        }


        .ai-chat-input {
            flex: 1;

            resize: none;

            min-height: 42px;
            max-height: 110px;

            padding: 11px 13px;

            border:
                1px solid rgba(128,128,128,0.25);

            border-radius: 10px;

            background:
                rgba(255,255,255,0.5);

            color: inherit;

            outline: none;

            font: inherit;

            font-size: 13px;

            line-height: 1.4;
        }


        .ai-chat-input:focus {
            border-color:
                rgba(99,102,241,0.65);
        }


        .ai-chat-send {
            min-width: 76px;

            height: 42px;

            border: none;

            border-radius: 10px;

            background: #6366f1;

            color: white;

            cursor: pointer;

            font-weight: 600;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;
        }


        .ai-chat-send:hover {
            opacity: 0.9;
        }


        .ai-chat-send:disabled {
            opacity: 0.5;

            cursor: not-allowed;
        }


        .ai-send-icon {
            font-size: 16px;
        }


        /* =====================================================
           HINT
        ====================================================== */

        .ai-chat-hint {
            padding:
                0 20px 12px 20px;

            text-align: right;

            font-size: 9px;

            opacity: 0.45;
        }


        /* =====================================================
           MOBILE
        ====================================================== */

        @media (max-width: 700px) {

            .ai-chat-header {
                align-items: flex-start;

                flex-direction: column;
            }


            .ai-chat-header-right {
                width: 100%;

                justify-content: space-between;
            }


            .ai-chat-messages {
                height: 350px;

                padding: 15px;
            }


            .ai-message {
                max-width: 94%;

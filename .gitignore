# ============================================================
# REVENUE RECOVERY AGENT
# Git Ignore
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# Google Cloud / Firebase credentials
service-account*.json
*-service-account*.json
google-credentials*.json
firebase-adminsdk*.json

# ------------------------------------------------------------
# Runtime / Generated Application State
# ------------------------------------------------------------

data/runtime/
data/processed/
logs/
*.log

# Recovery execution state
recovery_events.json

# ------------------------------------------------------------
# Backups
# ------------------------------------------------------------

backup/
backups/

# Backup files anywhere in the repository
**/*_backup*.py
**/*_backup*.csv
**/*_backup*.json
**/*_backup*.html
**/*_backup*.js
**/*_backup*.css

# Files created before a change
**/*_before_*.py
**/*_before_*.csv
**/*_before_*.json
**/*_before_*.html
**/*_before_*.js
**/*_before_*.css

# Timestamped / named backup variants
**/*backup-before-*
**/*backup_before_*

# Generic backup extensions
*.bak
*.backup
*.orig

# ------------------------------------------------------------
# Temporary Installation / Update Packages
# ------------------------------------------------------------

*_update/
*_package/
*.zip

# Temporary / generated PowerShell installers
install_*.ps1

# ------------------------------------------------------------
# Temporary Investigation / Test Files
# ------------------------------------------------------------

*_check.json
*_test.json
*.tmp
*.temp

# ------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------

Thumbs.db
Desktop.ini
.DS_Store

# ------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo

# ------------------------------------------------------------
# Node / Frontend Tooling
# ------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.cache/
.parcel-cache/

# ------------------------------------------------------------
# Coverage / Test Output
# ------------------------------------------------------------

coverage/
.nyc_output/